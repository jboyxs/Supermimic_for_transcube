# Notebook checkpoints
.ipynb_checkpoints/

# Local environment variables (keep example files trackable)
.env
.env.*
!.env.example
!.env.*.example

# Local logs
*.log

# Editor and operating system files
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

