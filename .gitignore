*.py[cod]
*$py.class

# Virtual environments and local uv cache
.venv/
venv/
env/
ENV/
.uv-cache/

# Build and packaging output
build/
dist/
*.egg-info/
*.egg
.eggs/

# Test, coverage, type checking, and lint caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/
.mypy_cache/
.pyright/
.ruff_cache/
